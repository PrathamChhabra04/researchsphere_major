# --- Server ---
PORT=5001
NODE_ENV=development
# Frontend origin allowed by CORS (Vite dev server runs on 8080)
FRONTEND_URL=http://localhost:8080

# --- Harvester ---
# How often the background harvester refreshes all sources (hours)
HARVEST_INTERVAL_HOURS=6
# SQLite database for harvested listings (default: server/data/harvest.db)
# HARVEST_DB_PATH=./data/harvest.db
# Days to keep listings a source no longer publishes, and expired listings
HARVEST_UNSEEN_RETENTION_DAYS=21
HARVEST_EXPIRED_RETENTION_DAYS=30

# --- Research Collaboration form (email notifications) ---
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
COLLABORATION_EMAIL=
